# HTTPS automático para el dominio del colegio; www redirige al dominio principal.
{$DOMAIN} {
	encode zstd gzip
	# Desde internet solo se ve si el sitio está vivo; el detalle de salud se consulta dentro del servidor.
	@privado {
		path /actuator/*
		not path /actuator/health/liveness
	}
	respond @privado 404
	reverse_proxy app:8080
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
