# Copia este archivo a .env (o usa ./instalar.sh, que lo genera) y completa los valores.

# Dominio del sitio, sin https:// (debe apuntar a este servidor y coincidir con la licencia).
DOMAIN=colegiosanjose.cl

# Licencia entregada por el proveedor (una línea).
APP_LICENSE=

# Llaves de cifrado de datos personales: generadas una vez por instalación. Si se pierden, los datos cifrados
# no se pueden leer. Guárdalas fuera del servidor también. (openssl rand -base64 32)
APP_FIELD_KEY=
APP_INDEX_KEY=

# Contraseñas de la base de datos (openssl rand -base64 24).
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Token para el asistente de primer arranque (https://DOMINIO/setup). Bórralo después de instalar.
APP_SETUP_TOKEN=

# Correo saliente.
APP_MAIL_FROM=no-responder@colegiosanjose.cl
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Alertas de operación para el proveedor (respaldos, licencia, antivirus, disco).
APP_ALERTS_EMAIL=

# Versión de la imagen. "latest" sigue la última; fija una (p. ej. 1.0.0) para actualizar a mano.
APP_VERSION=latest
# Canal de actualizaciones que muestra el panel (opcional).
APP_UPDATES_FEED_URL=

# Almacenamiento: local (volumen del servidor) o s3.
APP_STORAGE_TYPE=local
APP_S3_ENDPOINT=
APP_S3_BUCKET=
APP_S3_ACCESS_KEY=
APP_S3_SECRET_KEY=

# Respaldos: hora del día (0-23) y días que se guardan.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# Analítica externa opcional (solo se carga con consentimiento).
APP_ANALYTICS_SCRIPT_URL=
